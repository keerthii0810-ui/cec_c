#include<iostream>
#include<string>
using namespace std;
class student{
    public:
    string name;
    int age;
    student(string n,int a):name(n),age(a){}
    void display(){
        cout<<name<<"("<<age<<"years old)"<<endl; 
}
};
int main(){
    student* s1=new student("Alice",20);
    student* s2=new student("Bob",22);
    s1->display();
    s2->display();
    delete s1;
    delete s2;
    return 0;
}
