#include<iostream>
#include<string>
using namespace std;
template<typename T>
T getmax(T a,T b){
    return (a>b)?a:b;
}
template<typename T, typename U>
auto add(T a,U b)->decltype(a+b){
    return a+b;
}
int main(){
    cout<<"max of 10 and 20 is:"<<getmax(10,20)<<endl;
    cout<<"max of 3.14 and 2.71 is:"<<getmax(3.14,2.71)<<endl;
    cout<<"max of 'A' and 'B' is:"<<getmax('A','B')<<endl;
   cout<<"max(explicit double):"<<getmax<double>(10,20.5)<<endl;
   cout<<"add int+double:"<<add(10,3.14)<<endl;
   cout<<"add int+string:"<<add("42",to_string(100))<<endl;
    return 0;   
}