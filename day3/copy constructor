#include <iostream>
#include <string>
using namespace std;{
class student {
    public:
        char* name;
        int age;
        
        // Parameterized constructor
        student(const char* n, int a)
            age = a;
            name = new char[strlen(n) + 1];
          }          
        
        // Copy constructor
        student(const student &s) {
            name = new char[strlen(s.name) + 1];
            strcpy(name, s.name);
            age = s.age;
            cout << "Copy constructor called for: " << name << endl;
        }
        
        void display() {
            cout << name  << "( Age: " << age << ") " << endl;
        }
};
int main(){
    student s1("Alice", 20);
    student s2 = s1; // Copy constructor is called
    s1.display();
    s2.display();
    s2.name[0] = 'E'; // Modifying s2's name to show deep copy
    
    cout << "\nafter modification:" << endl;
    s1.display();
    s2.display();
    
    return 0;

}
