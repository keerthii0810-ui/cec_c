#include<iostream>
using namespace std;
int main(){
    int x=42;
    int*ptr;
    ptr=&x;
    cout<<"Value of x: "<<x<<endl;
    cout<<"Address of x: "<<&x<<endl;
    cout<<"Value of ptr: "<<ptr<<endl;
    cout<<"value at address stored in ptr: "<<*ptr<<endl;
    *ptr=100;
    cout<<"x after *ptr=100: "<<x<<endl;
    return 0;
}